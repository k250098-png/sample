# 1. OBJECT-ORIENTED PROGRAMMING (OOP)
# Encapsulation, Inheritance, and Polymorphism
# =====================================================================
class BaseAgent:
    def __init__(self, agent_id: int, name: str):
        self.agent_id = agent_id        # Public attribute[span_0](start_span)[span_0](end_span)
        self._status = "Idle"           # Protected attribute[span_1](start_span)[span_1](end_span)
        self.__secret_key = "SEC-99"    # Private attribute (Encapsulation)[span_2](start_span)[span_2](end_span)

    def get_secret_key(self):           # Getter method for private attribute[span_3](start_span)[span_3](end_span)
        return self.__secret_key

    def run_task(self):                 # Method to be overridden (Polymorphism)[span_4](start_span)[span_4](end_span)
        raise NotImplementedError("Subclasses must implement run_task()")

class SecurityAgent(BaseAgent):         # Single Inheritance[span_5](start_span)[span_5](end_span)
    def run_task(self):                 # Method Overriding[span_6](start_span)[span_6](end_span)
        self._status = "Scanning"
        return f"[SecurityAgent {self.agent_id}]: Status set to {self._status}."

class AnalysisAgent(BaseAgent):         # Single Inheritance[span_7](start_span)[span_7](end_span)
    def run_task(self):                 # Method Overriding[span_8](start_span)[span_8](end_span)
        self._status = "Processing"
        return f"[AnalysisAgent {self.agent_id}]: Status set to {self._status}."


