# 4. NUMPY: ARRAYS, RESHAPING, SLICING, MASKING & AGGREGATIONS
# =====================================================================
def run_numpy_pipeline():
    # 1D Array creation[span_48](start_span)[span_48](end_span)
    raw_data = np.array([52, 88, 95, 41, 63, 79, 85, 92, 70, 81, 60, 99])[span_49](start_span)[span_49](end_span)
    
    # Array Reshaping: 12 elements -> 4 rows x 3 columns (e.g., 4 models, 3 evaluation runs)[span_50](start_span)[span_50](end_span)
    matrix = raw_data.reshape(4, 3)[span_51](start_span)[span_51](end_span)
    print("\n[NumPy Array Matrix (4x3)]:\n", matrix)[span_52](start_span)[span_52](end_span)
    print("Shape:", matrix.shape, "| Dimensions:", matrix.ndim)[span_53](start_span)[span_53](end_span)

    # Indexing and Slicing: Extract sub-matrix (Rows 0 to 1, Columns 1 to 2)[span_54](start_span)[span_54](end_span)
    sub_matrix = matrix[0:2, 1:3][span_55](start_span)[span_55](end_span)
    print("\n[Sliced Matrix (Rows 0-1, Cols 1-2)]:\n", sub_matrix)[span_56](start_span)[span_56](end_span)

    # Matrix Multiplication (@ operator)[span_57](start_span)[span_57](end_span)
    weights = np.ones((3, 2))                    # Shape (3x2)[span_58](start_span)[span_58](end_span)
    weighted_scores = matrix @ weights           # Shape (4x3) @ (3x2) -> (4x2)[span_59](start_span)[span_59](end_span)
    print("\n[Matrix Multiplication (@) Result Shape]:", weighted_scores.shape)[span_60](start_span)[span_60](end_span)

    # Aggregations & Axis Operations[span_61](start_span)[span_61](end_span)
    # axis=0: Aggregate down columns (Average score per evaluation run)[span_62](start_span)[span_62](end_span)
    run_averages = np.mean(matrix, axis=0)[span_63](start_span)[span_63](end_span)
    # axis=1: Aggregate across rows (Average score per model)[span_64](start_span)[span_64](end_span)
    model_averages = np.mean(matrix, axis=1)[span_65](start_span)[span_65](end_span)
    
    print("\nEvaluation Run Averages (axis=0):", run_averages)[span_66](start_span)[span_66](end_span)
    print("Model-wise Averages (axis=1):", model_averages)[span_67](start_span)[span_67](end_span)
    print("Highest Overall Score:", np.max(matrix))[span_68](start_span)[span_68](end_span)
    print("Index of Best Model:", np.argmax(model_averages))[span_69](start_span)[span_69](end_span)

    # Boolean Masking and Data Filtering[span_70](start_span)[span_70](end_span)
    mask = matrix >= 80[span_71](start_span)[span_71](end_span)
    high_scores = matrix[mask]                   # Extract elements >= 80[span_72](start_span)[span_72](end_span)
    print("\n[Boolean Masking] All scores >= 80:", high_scores)[span_73](start_span)[span_73](end_span)

    # Vectorized Conditional Selection using np.where()[span_74](start_span)[span_74](end_span)
    status_matrix = np.where(matrix >= 70, "PASS", "FAIL")[span_75](start_span)[span_75](end_span)
    print("\n[np.where Conditional Status Matrix]:\n", status_matrix)[span_76](start_span)[span_76](end_span)


