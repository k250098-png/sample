# 2. DATA HANDLING, FUNCTIONS, LAMBDAS & DATA STRUCTURES
# Lists, Dictionaries, Sets, Tuples, enumerate, zip, Lambda & Filtering
# =====================================================================
def process_experiment_data(raw_scores: list, *tags, **metadata):
    # Sets: Deduplication[span_9](start_span)[span_9](end_span)
    unique_tags = set(tags)[span_10](start_span)[span_10](end_span)
    
    # Tuples and Enumerate: Pair model indexes with raw scores[span_11](start_span)[span_11](end_span)
    model_tuples = [(f"Model_{idx+1}", score) for idx, score in enumerate(raw_scores)][span_12](start_span)[span_12](end_span)
    
    # Lambda Functions & Sorting: Sort by score in descending order[span_13](start_span)[span_13](end_span)
    sorted_models = sorted(model_tuples, key=lambda x: x[1], reverse=True)[span_14](start_span)[span_14](end_span)
    
    # Dictionaries: Store structured key-value pairs[span_15](start_span)[span_15](end_span)[span_16](start_span)[span_16](end_span)
    score_dict = {name: score for name, score in sorted_models}[span_17](start_span)[span_17](end_span)
    
    # Filtering with Lambda: Select models with score >= 0.75[span_18](start_span)[span_18](end_span)
    passing_models = list(filter(lambda item: item[1] >= 0.75, sorted_models))[span_19](start_span)[span_19](end_span)
    
    # zip(): Map metrics to a list of values[span_20](start_span)[span_20](end_span)
    metrics = ["Accuracy", "Precision", "Recall"][span_21](start_span)[span_21](end_span)
    values = [0.88, 0.85, 0.90][span_22](start_span)[span_22](end_span)
    metric_map = dict(zip(metrics, values))[span_23](start_span)[span_23](end_span)
    
    return score_dict, unique_tags, passing_models, metric_map


